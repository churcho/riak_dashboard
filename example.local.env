# Riak Dashboard — Local Dev Environment
# Copy to local.env, uncomment ONE profile below, and source before running.
#
#   bash/zsh: source local.env && mix phx.server
#   fish:     source local.env; and mix phx.server
#
# fish users: replace "export" with "set -x" in your local.env copy.
#
# GOTCHA: RIAK_ADMIN_URL and RIAK_WS_URL must point at the same port.
# If you set RIAK_ADMIN_URL to a devrel port (10015) but leave RIAK_WS_URL
# on the standalone default (8099), the HTTP API will work but the
# WebSocket stream won't connect — and pages will show "Not Connected".

# ── Quickstart devrel cluster (most common) ───────────────────
# devrel nodes expose the admin API (Cowboy) on:
#   dev1=10015  dev2=10025  dev3=10035  dev4=10045  dev5=10055
# export RIAK_ADMIN_URL=http://127.0.0.1:10015
# export RIAK_WS_URL=ws://127.0.0.1:10015/api/stream/events

# ── Standalone single node ────────────────────────────────────
# export RIAK_ADMIN_URL=http://localhost:8099
# export RIAK_WS_URL=ws://localhost:8099/api/stream/events

# ── Basic auth credentials ────────────────────────────────────
# export RIAK_DASHBOARD_USER=admin
# export RIAK_DASHBOARD_PASS=password
