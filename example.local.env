# Riak Dashboard — Local Dev Environment
# Copy this to .env and adjust values for your setup.
# Source it before running: source .env && mix phx.server

# Riak Admin API (Cowboy HTTP endpoint)
# export RIAK_ADMIN_URL=http://localhost:8099

# Riak WebSocket stream (set to enable real-time mode instead of mock polling)
# export RIAK_WS_URL=ws://localhost:8099/api/stream/events

# Basic auth credentials
# export RIAK_DASHBOARD_USER=admin
# export RIAK_DASHBOARD_PASS=password
