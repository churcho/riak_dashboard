# Riak Dashboard — Local Dev Environment
# Copy this to .env and adjust values for your setup.
# Source it before running: source local.env; mix phx.server

# This file is shell-agnostic: it runs a small POSIX shell
# helper to detect the active admin listener.
#
# Override these before sourcing to use a fixed target:
# - RIAK_ADMIN_PORT
# - RIAK_DASHBOARD_USER
# - RIAK_DASHBOARD_PASS

eval "$(
  sh -c '
    # Resolve admin port:
    if [ -z "${RIAK_ADMIN_PORT+x}" ]; then
      for port in 10015 10025 10035 10045 10055 10065 10075 10085 10095; do
        if curl -fsS --max-time 1 "http://127.0.0.1:${port}/api/ping" >/dev/null 2>&1; then
          export RIAK_ADMIN_PORT="$port"
          break
        fi
      done
    fi

    if [ -z "${RIAK_ADMIN_PORT+x}" ]; then
      export RIAK_ADMIN_PORT=10015
    fi

    if [ -z "${RIAK_DASHBOARD_USER+x}" ]; then
      export RIAK_DASHBOARD_USER=admin
    fi

    if [ -z "${RIAK_DASHBOARD_PASS+x}" ]; then
      export RIAK_DASHBOARD_PASS=password
    fi

    export RIAK_ADMIN_URL="http://127.0.0.1:${RIAK_ADMIN_PORT}"
    export RIAK_WS_URL="ws://127.0.0.1:${RIAK_ADMIN_PORT}/api/stream/events"

    printf "export RIAK_ADMIN_PORT=%q\n" "$RIAK_ADMIN_PORT"
    printf "export RIAK_ADMIN_URL=%q\n" "$RIAK_ADMIN_URL"
    printf "export RIAK_WS_URL=%q\n" "$RIAK_WS_URL"
    printf "export RIAK_DASHBOARD_USER=%q\n" "$RIAK_DASHBOARD_USER"
    printf "export RIAK_DASHBOARD_PASS=%q\n" "$RIAK_DASHBOARD_PASS"
  ' 
)"
